# test_rd_bk_no_nvs (rd wave 1 Task 14, lesson 8; the controller's ruling): Bunk Clock's count is derived from the clock
# and its taps and pause live in fk_face's RAM variant, so bunk.c's object names no settings, store, preference or NVS
# symbol: `nm -u` of it must hold none of nvs_*, settings*, store_*, omni_settings*, rd_prefs*, kv_*. -DNM=<nm>
# -DOBJS=<rd_core's objects, |-separated> (CMakeLists.txt, $<TARGET_OBJECTS:rd_core>); bunk.c's is picked by name.
# -DSRC=<a face's file stem> (Task 15: test_rd_cu_no_nvs runs it on curry.c, whose chillies are the RAM variant's too;
# default bunk).
if(NOT SRC)
    set(SRC bunk)
endif()
string(REPLACE "|" ";" objs "${OBJS}")
set(obj "")
foreach(o ${objs})
    get_filename_component(name "${o}" NAME)
    if(name MATCHES "^${SRC}[.]c[.]o(bj)?$")
        set(obj "${o}")
    endif()
endforeach()
if(NOT obj)
    message(FATAL_ERROR "no_nvs: no ${SRC}.c object among rd_core's (${OBJS})")
endif()
execute_process(COMMAND "${NM}" -u "${obj}" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "nm -u ${obj} failed (${rc})")
endif()
string(REPLACE "\n" ";" syms "${out}")
set(hits "")
set(n 0)
foreach(line ${syms})
    string(STRIP "${line}" line)
    string(REGEX REPLACE "^U[ \t]+" "" sym "${line}")
    string(REGEX REPLACE "^_" "" sym "${sym}")
    if(sym STREQUAL "")
        continue()
    endif()
    math(EXPR n "${n} + 1")
    if(sym MATCHES "^(nvs_|settings|store_|omni_settings|rd_prefs|kv_)")
        list(APPEND hits "${sym}")
    endif()
endforeach()
if(n LESS 3)
    message(FATAL_ERROR "no_nvs: ${SRC}.c.o names only ${n} symbols: is it the face?")
endif()
if(hits)
    message(FATAL_ERROR "no_nvs: ${SRC}.c names a settings or store symbol (lesson 8): ${hits}")
endif()
message(STATUS "no_nvs: ${SRC}.c.o's ${n} undefined symbols name no settings, store or NVS")
